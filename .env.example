ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=localhost;Database=wedding;Username=wedding;Password=<local-secret>;Maximum Pool Size=10
ConnectionStrings__Migrations=Host=localhost;Database=wedding;Username=wedding;Password=<local-secret>
Frontend__PublicOrigin=https://site.example.com
Cors__AllowedOrigins__0=https://site.example.com
Authentication__CookieSameSite=Lax
MercadoPago__Environment=test
MercadoPago__AccessToken=<secret>
MercadoPago__WebhookSecret=<secret>
MercadoPago__ReceiverId=<receiver-id>
MercadoPago__ApplicationId=<application-id>
MercadoPago__NotificationUrl=https://api.example.com/api/webhooks/mercadopago
MercadoPago__CheckoutEnabled=false
MercadoPago__SandboxSingleAttempt=false
# Set only after verifying the provider's retention guarantee and sandbox configuration:
MercadoPago__IdempotencyWindowMinutes=0
MercadoPago__ValidatedConfigJson=
DataProtection__ApplicationName=WeddingGifts
DataProtection__CertificateBase64=<secret-pfx-base64>
DataProtection__CertificatePassword=<secret>
# Production additionally requires SSL Mode=VerifyFull on both database connections.
# Set explicit Render proxy addresses/networks from the deployment environment.
ForwardedHeaders__KnownNetworks__0=<trusted-proxy-cidr>
